<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="sankalan_lock_store.xml" />
        <exclude domain="sharedpref" path="sankalan_update_prefs.xml" />
        <exclude domain="database" path="sankalan_local.db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="sankalan_lock_store.xml" />
        <exclude domain="sharedpref" path="sankalan_update_prefs.xml" />
        <exclude domain="database" path="sankalan_local.db" />
    </device-transfer>
</data-extraction-rules>
